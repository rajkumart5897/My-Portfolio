{
  // Cloudflare Workers config for deploying the static HTML/CSS/JS site in
  // web-src/ as static assets -- no Worker script needed (no "main" field
  // below), since there's no server-side logic: the browser only runs
  // theme.js. This only covers web-src/; linux-src/ (the GTK4 desktop app)
  // is a separate, native build and isn't deployed here. See
  // docs/getting-started.md for both builds.
  "name": "my-portfolio",
  "compatibility_date": "2026-11-04",
  "assets": {
    // web-src/ is the site's source and its deployable output in one --
    // there's no separate build step, so this points straight at it.
    "directory": "./web-src"
  }
}
